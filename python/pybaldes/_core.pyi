from os import PathLike
from typing import Any, Optional, Union

__version__: str
resource_dimensions: int
has_clp: bool

class Route:
    @property
    def cost(self) -> float: ...
    @property
    def original_cost(self) -> float: ...
    @property
    def nb_nodes(self) -> int: ...
    @property
    def is_certified(self) -> bool: ...
    def nodes(self) -> list[int]: ...
    def arcs(self) -> list[int]: ...
    def resource_consumption(self, resource_id: int) -> float: ...

class Phase:
    @property
    def check_ng(self) -> bool: ...
    @property
    def allow_jump_arcs(self) -> bool: ...
    @property
    def labels_per_bucket(self) -> int: ...

class EncodedFunction:
    @staticmethod
    def knots(points: list[tuple[float, float]]) -> EncodedFunction: ...
    @staticmethod
    def slope_segments(prepared_pairs: list[tuple[float, float]], policy: str = "strict_domain") -> EncodedFunction: ...
    @staticmethod
    def affine(intercept: float, slope: float, lower: float, upper: float, policy: str = "strict_domain") -> EncodedFunction: ...
    @staticmethod
    def from_dict(definition: dict[str, Any]) -> EncodedFunction: ...
    def to_dict(self) -> dict[str, Any]: ...
    def value(self, argument: float) -> Optional[float]: ...
    @property
    def encoding(self) -> str: ...
    @property
    def policy(self) -> Optional[str]: ...

class ResourceModel:
    def add_paired_piecewise_linear(self, initial_lower: float, initial_upper: float, initial: list[tuple[float, float]], arrivals: list[list[tuple[float, float]]], increments: list[list[tuple[float, float]]], lowers: list[list[tuple[float, float]]], uppers: list[list[tuple[float, float]]], waiting: list[int], mode: str = "feasibility") -> int: ...
    def add_interval_cost(self, initial_lower: float, initial_upper: float, lower: float, upper: float, increments: list[float], functions: list[list[tuple[float, float]]]) -> int: ...
    def add_slope_interval_cost(self, initial_lower: float, initial_upper: float, lower: float, upper: float, increments: list[float], functions: list[EncodedFunction], policy: str = "strict_domain") -> int: ...
    def add_slope_paired(self, initial_lower: float, initial_upper: float, initial: EncodedFunction, arrivals: list[EncodedFunction], increments: list[EncodedFunction], lowers: list[EncodedFunction], uppers: list[EncodedFunction], waiting: list[int], mode: str = "feasibility", policy: str = "strict_domain", normalization: str = "absolute_final_value") -> int: ...
    def __init__(self) -> None: ...
    def install(self, solver: Solver) -> None: ...
    def add_selection(
        self,
        initial: int,
        allowed: list[int],
        vertices: list[int] | None = None,
        relaxed: bool = False,
    ) -> int: ...
    def add_simultaneous_pickup_delivery(self, capacity: float, deliveries: list[float], pickups: list[float], tolerance: float = 1e-6) -> int: ...
    def add_cumulative_cost(
        self,
        initial: float,
        increments: list[float],
        weights: list[float],
        sink_upper: float | None = None,
        source_upper: float | None = None,
    ) -> int: ...
    def add_custom_resource(
        self,
        increments: list[float],
        weights: list[float],
        forward_bound: float | None = None,
        backward_bound: float | None = None,
    ) -> int: ...
    def add_piecewise_linear_resource(self, initial: float, lower: float, upper: float, functions: list[list[tuple[float, float]]]) -> int: ...
    def add_piecewise_linear_cost(self, parent: int, functions: list[list[tuple[float, float]]]) -> int: ...
    def add_piecewise_linear_dependent(self, parent: int, initial: float, lower: float, upper: float, functions: list[list[tuple[float, float]]]) -> int: ...
    def add_encoded_piecewise_linear_resource(self, initial: float, lower: float, upper: float, functions: list[EncodedFunction]) -> int: ...
    def add_encoded_piecewise_linear_cost(self, parent: int, functions: list[EncodedFunction]) -> int: ...
    def add_encoded_piecewise_linear_dependent(self, parent: int, initial: float, lower: float, upper: float, functions: list[EncodedFunction]) -> int: ...
    def add_dependent(self, parent: int, initial: float, lower: float, upper: float, offsets: list[float], factors: list[float]) -> int: ...

class Solver:
    def __init__(self, n_vertices: int, n_resources: int) -> None: ...
    def set_source(self, v: int) -> None: ...
    def set_sink(self, v: int) -> None: ...
    def set_graph_id(self, id: int) -> None: ...
    def new_arc(self, tail: int, head: int, cost: float) -> int: ...
    def new_resource(self, _name: str, kind: int) -> int: ...
    def set_resource_type(self, resource_id: int, kind: int) -> None: ...
    def set_arc_consumption(self, arc_id: int, resource_id: int, value: float) -> None: ...
    def set_vertex_bounds(self, vertex_id: int, resource_id: int, lower: float, upper: float) -> None: ...
    # Available when built with the multi-time-windows feature.
    def set_vertex_time_windows(self, vertex_id: int, resource_id: int, windows: list[tuple[float, float]]) -> None: ...
    def set_initial_resource(self, resource_id: int, value: float) -> None: ...
    def set_ng_neighborhood(self, vertex_id: int, nodes: list[int]) -> None: ...
    def add_elementarity_set(self, nodes: list[int]) -> int: ...
    def attach_elementarity_to_node(self, vertex_id: int, set_id: int) -> None: ...
    def set_pricing_controls(self, cutoff: float, max_labels: int, max_columns: int) -> None: ...
    def set_option(self, name: str, value: float) -> None: ...
    def get_option(self, name: str) -> float: ...
    @staticmethod
    def option_names() -> list[str]:
        """Supported canonical BALDES option names for this build."""
        ...
    @staticmethod
    def option_support(name: str) -> tuple[bool, str]: ...
    def build_default_resource_buckets(self) -> None: ...
    def update_reduced_costs(self, costs: list[float], duals: list[float]) -> None: ...
    def set_reduced_costs(self, costs: list[float]) -> None: ...
    def set_bidirectional_mode(self, mode: int) -> None: ...
    def solve(self) -> Optional[tuple[float, Route]]: ...
    def price(self, maximum: int) -> tuple[float, list[Route]]: ...
    def price_with_status(self, maximum: int, *, exact: bool = False) -> tuple[float, list[Route], bool]: ...
    def enumerate(self, maximum: int) -> tuple[float, int, list[Route]]: ...
    @property
    def phase_count(self) -> int: ...
    def get_phase(self, index: int) -> Phase: ...
    @property
    def enumerated_count(self) -> int: ...
    def get_enumerated(self, index: int) -> Route: ...

def _read_instance(path: Union[str, PathLike]) -> dict[str, Any]: ...
def _solve_root(*args: Any) -> dict[str, Any]: ...

class _NetworkNode:
    def solve(self, options_json: str) -> tuple[str, _NetworkNode]: ...
    def branch_assignment(self, shared_row: int, network: int, assigned: bool) -> _NetworkNode: ...
    def with_row(self, row_json: str) -> _NetworkNode: ...
    def with_synchronized_start(self, id: int, lower: int, upper: int) -> _NetworkNode: ...
    def fix_route(self, route_index: int, quantity: float) -> _NetworkNode: ...
    def solve_enumerated_mip(self, time_limit: float, node_limit: int, objective_cutoff: Optional[float]) -> Optional[str]: ...
    def fractional_assignments(self, tolerance: float) -> list[tuple[int, int, float]]: ...

def _solve_networks(model_json: str, options_json: str) -> tuple[str, Optional[_NetworkNode]]: ...
